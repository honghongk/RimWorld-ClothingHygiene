<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!--
    M6 자동 갈아입기. job.targetA = 입을 예비복(Apparel), job.targetB = 벗겨질 착용 의복.
    reportString 은 표시용 폴백일 뿐이고, 실제 표시 문자열은 JobDriver_ChangeClothing.GetReport() 가
    Keyed 번역키(CH_JobReport_ChangeClothing)로 만든다.
  -->
  <JobDef>
    <defName>CH_ChangeClothing</defName>
    <driverClass>ClothingHygiene.Infrastructure.JobDriver_ChangeClothing</driverClass>
    <reportString>changing into TargetA.</reportString>
  </JobDef>

</Defs>
