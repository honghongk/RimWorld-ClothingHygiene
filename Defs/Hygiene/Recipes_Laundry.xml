    <soundWorking>Recipe_Machining</soundWorking>
    <workAmount>900</workAmount>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>WoodLog</li>
          </thingDefs>
        </filter>
        <count>8</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>Cloth</li>
          </thingDefs>
        </filter>
        <count>2</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>WoodLog</li>
        <li>Cloth</li>
      </thingDefs>
    </fixedIngredientFilter>
    <products>
      <CH_Soap>2</CH_Soap>
    </products>
    <recipeUsers>
      <li>CraftingSpot</li>
    </recipeUsers>
    <researchPrerequisite>ClothingHygiene_Soap</researchPrerequisite>
    <workSkill>Crafting</workSkill>
    <skillRequirements>
      <Crafting>2</Crafting>
    </skillRequirements>
    <displayPriority>0</displayPriority>
  </RecipeDef>

</Defs>
